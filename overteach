<title>Overteach | Mechaniker Preisliste</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at top, #202020 0%, #0b0b0b 45%, #050505 100%);
    color: #fff;
    min-height: 100vh;
}

header {
    text-align: center;
    padding: 60px 20px 40px;
    border-bottom: 1px solid #292929;
}

.logo {
    font-size: 48px;
    font-weight: 900;
    letter-spacing: 5px;
}

.logo span {
    color: #ff8c00;
}

.subtitle {
    color: #999;
    margin-top: 10px;
    font-size: 15px;
    letter-spacing: 2px;
}

.container {
    width: 92%;
    max-width: 1200px;
    margin: 40px auto;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 35px 0 18px;
    font-size: 24px;
}

.section-title::before {
    content: "";
    width: 5px;
    height: 28px;
    background: #ff8c00;
    border-radius: 5px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
}

.card {
    background: rgba(20,20,20,.95);
    border: 1px solid #292929;
    border-radius: 12px;
    padding: 20px;
    transition: .2s;
}

.card:hover {
    transform: translateY(-3px);
    border-color: #ff8c00;
}

.card h3 {
    font-size: 18px;
    margin-bottom: 8px;
}

.card p {
    color: #888;
    font-size: 13px;
}

.price {
    margin-top: 15px;
    font-size: 22px;
    font-weight: bold;
    color: #ff9d22;
}

.percent {
    color: #fff;
    font-weight: bold;
}

.info {
    background: #111;
    border: 1px solid #292929;
    border-radius: 12px;
    padding: 25px;
}

.info-row {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid #242424;
}

.info-row:last-child {
    border-bottom: none;
}

.green {
    color: #42d77d;
}

.orange {
    color: #ff9d22;
}

.red {
    color: #ff5555;
}

/* Rechner */

.calculator {
    margin-top: 45px;
    background: #111;
    border: 1px solid #292929;
    border-radius: 14px;
    padding: 30px;
}

.calculator h2 {
    margin-bottom: 20px;
}

input, select {
    width: 100%;
    padding: 14px;
    margin: 8px 0 15px;
    background: #080808;
    color: white;
    border: 1px solid #333;
    border-radius: 8px;
}

button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #ff8c00;
    color: #000;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #ffa52f;
}

.result {
    margin-top: 20px;
    text-align: center;
    font-size: 26px;
    font-weight: bold;
    color: #ff9d22;
}

footer {
    text-align: center;
    color: #666;
    padding: 40px 20px;
    font-size: 13px;
}
</style>
</head>

<body>

