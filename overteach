    <div class="calculator">

        <h2>💰 Preisrechner</h2>

        <label>Grundpreis</label>
        <input type="number" id="price" placeholder="z.B. 5000">

        <label>Anpassung</label>

        <select id="percent">
            <option value="0">Keine Anpassung</option>
            <option value="25">+25 % Nachtzuschlag</option>
            <option value="50">+50 % Notfall</option>
            <option value="30">+30 % Außeneinsatz</option>
            <option value="-10">−10 % Stammkundenrabatt</option>
            <option value="-15">−15 % Fraktionsrabatt</option>
        </select>

        <button onclick="calculate()">Preis berechnen</button>

        <div class="result" id="result">
            $ 0
