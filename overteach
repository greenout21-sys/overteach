        </div>

        <div class="card">
            <h3>Bremsen-Service</h3>
            <p>Kontrolle und Wartung der Bremsanlage</p>
            <div class="price">$ 3.000</div>
        </div>

        <div class="card">
            <h3>Fahrwerk-Service</h3>
            <p>Überprüfung und Wartung</p>
            <div class="price">$ 3.500</div>
        </div>

        <div class="card">
            <h3>Komplett-Service</h3>
            <p>Umfassender Fahrzeugcheck</p>
            <div class="price">$ 6.000</div>
        </div>

    </div>

    <!-- TUNING -->
    <h2 class="section-title">⚙️ Tuning</h2>

    <div class="grid">

        <div class="card">
            <h3>Motor Stufe 1</h3>
